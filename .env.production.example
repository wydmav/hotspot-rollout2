# ==============================================================================
# T-Connect Cloud Controller — Production Environment Configuration
# Copy this file to .env on your VPS and update the values
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000

# Public Domain / FQDN for Caddy Automated HTTPS & Captive Portal
# Examples: hotspot.tconnect.co.ls or 154.68.x.x (if using IP only)
DOMAIN=app.tconnect.co.ls
VITE_CONTROLLER_DOMAIN=app.tconnect.co.ls
VITE_CURRENCY=M

# Remote Supabase PostgreSQL Ledger (Optional for Cloud Sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# MikroTik Zero-Touch Router Security Credentials
RADIUS_SECRET=radsec_tconnect_lesotho_99120
ROUTER_API_PASSWORD=tc_pass_crypto_random_32char

# WireGuard VPN Hub Configuration (Encrypted Router Overlay Network)
WIREGUARD_HUB_IP=10.99.0.1
WIREGUARD_PORT=51820
WIREGUARD_SUBNET=10.99.0.0/16
WIREGUARD_PRIVATE_KEY=v7TconnectHubWireguardKey2026Base64Salted==

# Lesotho Telecom Gateway Merchant Credentials
