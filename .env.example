# ==============================================================================
# T-Connect Control Tower — Environment Template (.env.example)
# NEVER commit real secrets to this file. Copy to .env (chmod 600) on the server.
# ==============================================================================
NODE_ENV=development
PORT=3000
VITE_CONTROLLER_DOMAIN=169.58.98.92:3000
PORTAL_ORIGIN=http://169.58.98.92:3000
ADMIN_ORIGIN=http://169.58.98.92:3000
VITE_CURRENCY=M

# Bootstrap Owner Account (E11)
OWNER_EMAIL=rphooko@tconnect.africa
ADMIN_SESSION_SECRET=<GENERATE_64_HEX_RANDOM_SECRET>

# Database (PostgreSQL 16 Primary Store - E3)
DATABASE_URL=postgresql://tconnect:<DB_PASSWORD>@postgres:5432/tconnect

# WireGuard & Router Management Plane (E5, E6)
WIREGUARD_SUBNET=10.99.0.0/16
WIREGUARD_HUB_IP=10.99.0.1
RADIUS_SECRET=<SET_IN_SERVER_ENV>
ROUTER_API_PASSWORD=<SET_IN_SERVER_ENV>

# PayLesotho & XPayments Aggregator (Values Frozen in Server .env - E1, E8)
PAYLESOTHO_MERCHANT_NAME=T-Connect
PAYLESOTHO_MPESA_MERCHANT_ID=62915
PAYLESOTHO_ECOCASH_MERCHANT_ID=63165430
PAYLESOTHO_BEARER_TOKEN=<SET_IN_SERVER_ENV_DO_NOT_COMMIT>
PAYLESOTHO_OTT_BEARER_TOKEN=<SET_IN_SERVER_ENV_DO_NOT_COMMIT>
PAYLESOTHO_ENDPOINT_URL=https://api.paylesotho.co.ls
PAYLESOTHO_XPAYMENTS_ENDPOINT_URL=https://xpayments.paylesotho.co.ls

# OTT Voucher Lesotho (Retail OTT Redemption Feature-Flagged OFF until contract supplied - E8)
ENABLE_RETAIL_OTT_REDEMPTION=false
AUTO_REDEEM_AFTER_PAYMENT=false
OTTVOUCHER_MERCHANT_ID=TCONNECTLES1
OTTVOUCHER_VENDOR_ID=1, 11
OTTVOUCHER_API_KEY=<SET_IN_SERVER_ENV_DO_NOT_COMMIT>
OTTVOUCHER_API_PASSWORD=<SET_IN_SERVER_ENV_DO_NOT_COMMIT>

# Human Alert Channels (E14: Email + Telegram/WhatsApp Webhook)
ALERT_EMAIL_TO=rphooko@tconnect.africa
TELEGRAM_BOT_TOKEN=<OPTIONAL_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<OPTIONAL_TELEGRAM_CHAT_ID>
WHATSAPP_WEBHOOK_URL=<OPTIONAL_WHATSAPP_WEBHOOK_URL>
